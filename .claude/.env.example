# 복사해서 .claude/.env 로 만들고 값 채우기. (.env는 gitignore — 이 example만 커밋됨)
# 키 값은 팀 리드에게 받기 (안전한 채널, 깃/슬랙 평문 금지).

# --- 전원 필요 ---
SUPABASE_URL=
SUPABASE_ANON_KEY=          # 로그 적재(insert 전용)
NOTION_TOKEN=               # /plan이 명세 읽을 때 필요

# --- 스크럼 요약 담당자만 ---
SUPABASE_SERVICE_ROLE_KEY=  # 로그 읽기(RLS 우회)
NOTION_DATABASE_ID=         # Daily Scrum DB id

# --- 선택: 비우면 자동 추론 ---
PROJECT=
# USER_NAME=                # 비우면 git config user.name
TOOL=                       # claude | codex
# AGENT_ROLE=               # 서브에이전트 역할 수동 지정(보통 자동 기록됨)
