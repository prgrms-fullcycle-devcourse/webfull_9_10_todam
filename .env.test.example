# 폰 실기 테스트(scripts/mobile-dev.mjs)용 설정. 복사해서 .env.test 로 사용.
#   cp .env.test.example .env.test
# .env.test 은 gitignore 됨(자격증명 보호).

# 토큰 발급에 쓸 파트너 계정
TODAM_DEV_EMAIL=partner@example.com
TODAM_DEV_PASSWORD=changeme

# (선택) 포트·진입경로 — 기본값과 다를 때만
# TODAM_WEB_PORT=3000
# TODAM_API_PORT=4000
# TODAM_NEXT=/partner/stores
