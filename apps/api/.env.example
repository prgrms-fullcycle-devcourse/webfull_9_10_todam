NODE_ENV=
PORT=
DATABASE_URL=
# 통합 테스트 전용 DB. 데이터베이스 이름에 integration을 포함해야 함.
TEST_DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ADMIN_SECRET=
REDIS_URL=
S3_BUCKET_NAME=
S3_REGION=
CORS_ORIGINS=
# 비밀번호 재설정 링크 base URL (FE 도메인)
FRONTEND_URL=

# AWS SES (이메일 인증코드 발송)
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY 는 AWS SDK 기본 자격증명 체인이 자동으로 읽음
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_REGION=
# SES에 인증된 도메인(todam.app) 또는 인증된 이메일 주소여야 함
SES_FROM_EMAIL=

# Kakao OAuth
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Google Cloud Vision (사업자등록증 OCR) — 서비스 계정 JSON의 client_email / private_key
# private_key 는 큰따옴표로 감싸고 \n 이스케이프를 그대로 둔다(코드에서 실제 줄바꿈으로 복원).
GOOGLE_VISION_CLIENT_EMAIL=
GOOGLE_VISION_PRIVATE_KEY=

# 국세청 사업자등록정보 진위확인·상태조회 (data.go.kr 일반 인증키 Decoding)
NTS_API_KEY=
