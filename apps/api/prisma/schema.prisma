generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  nickname             String               @db.VarChar(100)
  email                String               @unique @db.VarChar(255)
  password             String?              @db.VarChar(255)
  isPartner            Boolean              @default(false) @map("is_partner")
  status               UserStatus           @default(ACTIVE)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  withdrawnAt          DateTime?            @map("withdrawn_at") @db.Timestamptz(6)
  artworkLogs          ArtworkLog[]
  notificationSettings NotificationSetting?
  notifications        Notification[]
  oauthAccounts        OAuthAccount[]
  partner              Partner?
  refreshTokens        RefreshToken[]
  reports              Report[]
  canceledReservations Reservation[]        @relation("ReservationCanceledBy")
  reservations         Reservation[]        @relation("ReservationUser")
  reviews              Review[]
  consents             UserConsent[]

  @@map("users")
}

model NotificationSetting {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  inAppEnabled       Boolean  @default(true) @map("in_app_enabled")
  emailEnabled       Boolean  @default(true) @map("email_enabled")
  kakaoEnabled       Boolean  @default(false) @map("kakao_enabled")
  reservationEnabled Boolean  @default(true) @map("reservation_enabled")
  artworkEnabled     Boolean  @default(true) @map("artwork_enabled")
  shippingEnabled    Boolean  @default(true) @map("shipping_enabled")
  marketingEnabled   Boolean  @default(false) @map("marketing_enabled")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User     @relation(fields: [userId], references: [id])

  @@map("notification_settings")
}

model Admin {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  name      String    @db.VarChar(100)
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)

  @@map("admins")
}

model OAuthAccount {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  provider   OAuthProvider
  providerId String        @map("provider_id") @db.VarChar(255)
  user       User          @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Partner {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @unique @map("user_id") @db.Uuid
  status          PartnerStatus      @default(PENDING)
  rejectedReason  String?            @map("rejected_reason")
  suspendedReason String?            @map("suspended_reason")
  approvedAt      DateTime?          @map("approved_at") @db.Timestamptz(6)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  terminatedAt    DateTime?          @map("terminated_at") @db.Timestamptz(6)
  businessDocs    BusinessDocument[]
  user            User               @relation(fields: [userId], references: [id])
  stores          Store[]

  @@map("partners")
}

model BusinessDocument {
  id                 String     @id @default(uuid()) @db.Uuid
  partnerId          String     @map("partner_id") @db.Uuid
  storeId            String     @map("store_id") @db.Uuid
  documentUrl        String     @map("document_url") @db.VarChar(1000)
  representativeName String     @map("representative_name") @db.VarChar(100)
  businessName       String     @map("business_name") @db.VarChar(200)
  businessNumber     String     @map("business_number") @db.VarChar(20)
  businessAddress    String     @map("business_address") @db.VarChar(500)
  ocrStatus          OcrStatus? @map("ocr_status")
  ocrRaw             Json?      @map("ocr_raw")
  verifiedAt         DateTime?  @map("verified_at") @db.Timestamptz(6)
  createdAt          DateTime?  @map("created_at") @db.Timestamptz(6)
  partner            Partner    @relation(fields: [partnerId], references: [id])
  store              Store      @relation(fields: [storeId], references: [id])

  @@map("business_documents")
}

model Store {
  id              String               @id @default(uuid()) @db.Uuid
  partnerId       String               @map("partner_id") @db.Uuid
  name            String               @db.VarChar(200)
  slug            String               @unique @db.VarChar(100)
  convenienceInfo Json?                @map("convenience_info")
  rejectedReason  String?              @map("rejected_reason")
  suspendedReason String?              @map("suspended_reason")
  description     String?
  address         String?              @db.VarChar(500)
  phone           String?              @db.VarChar(20)
  autoConfirm     Boolean              @default(false) @map("auto_confirm")
  status          StoreStatus          @default(DRAFT)
  publishedAt     DateTime?            @map("published_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  businessDocs    BusinessDocument[]
  timeSlots       ProgramTimeSlot[]
  programs        Program[]
  reservations    Reservation[]
  reviews         Review[]
  images          StoreImage[]
  operatingHours  StoreOperatingHour[]
  partner         Partner              @relation(fields: [partnerId], references: [id])

  @@index([slug])
  @@index([partnerId])
  @@index([status])
  @@map("stores")
}

model StoreOperatingHour {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  dayOfWeek Int      @map("day_of_week")
  openTime  DateTime @map("open_time") @db.Time(6)
  closeTime DateTime @map("close_time") @db.Time(6)
  breakTime DateTime @map("break_time") @db.Time(6)
  store     Store    @relation(fields: [storeId], references: [id])

  @@map("store_operating_hours")
}

model StoreImage {
  id           String   @id @default(uuid()) @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  imageUrl     String   @map("image_url") @db.VarChar(1000)
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(1000)
  sortOrder    Int      @default(0) @map("sort_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  store        Store    @relation(fields: [storeId], references: [id])

  @@map("store_images")
}

model Program {
  id              String                @id @default(uuid()) @db.Uuid
  storeId         String                @map("store_id") @db.Uuid
  title           String                @db.VarChar(200)
  description     String?
  materials       String?
  caution         String?
  price           Int
  durationMinutes Int                   @map("duration_minutes")
  capacity        Int
  leadTimeDays    Int                   @default(30) @map("lead_time_days")
  deliveryOption  ProgramDeliveryOption @default(CUSTOMER_SELECT) @map("delivery_option")
  status          ProgramStatus         @default(DRAFT)
  thumbnailUrl    String?               @map("thumbnail_url") @db.VarChar(1000)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  snapshots       ProgramSnapshot[]
  timeSlots       ProgramTimeSlot[]
  store           Store                 @relation(fields: [storeId], references: [id])
  reservations    Reservation[]

  @@map("programs")
}

model ProgramSnapshot {
  id           String        @id @default(uuid()) @db.Uuid
  programId    String        @map("program_id") @db.Uuid
  price        Int
  capacity     Int
  leadTimeDays Int           @map("lead_time_days")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  program      Program       @relation(fields: [programId], references: [id])
  reservations Reservation[]

  @@map("program_snapshots")
}

model ProgramTimeSlot {
  id            String                @id @default(uuid()) @db.Uuid
  programId     String                @map("program_id") @db.Uuid
  storeId       String                @map("store_id") @db.Uuid
  startsAt      DateTime              @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime              @map("ends_at") @db.Timestamptz(6)
  capacity      Int
  reservedCount Int                   @default(0) @map("reserved_count")
  status        ProgramTimeSlotStatus @default(OPEN)
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  program       Program               @relation(fields: [programId], references: [id])
  store         Store                 @relation(fields: [storeId], references: [id])
  reservations  Reservation[]

  @@unique([programId, startsAt])
  @@index([storeId])
  @@index([status])
  @@map("program_time_slots")
}

model Reservation {
  id                String                    @id @default(uuid()) @db.Uuid
  userId            String                    @map("user_id") @db.Uuid
  programId         String                    @map("program_id") @db.Uuid
  storeId           String                    @map("store_id") @db.Uuid
  programTimeSlotId String                    @map("program_time_slot_id") @db.Uuid
  programSnapshotId String                    @map("program_snapshot_id") @db.Uuid
  scheduledAt       DateTime                  @map("scheduled_at") @db.Timestamptz(6)
  reserverName      String                    @map("reserver_name") @db.VarChar(100)
  reserverPhone     String                    @map("reserver_phone") @db.VarChar(20)
  participantCount  Int                       @default(1) @map("participant_count")
  deliveryMethod    ReservationDeliveryMethod @map("delivery_method")
  shippingAddress   String?                   @map("shipping_address")
  status            ReservationStatus         @default(PENDING)
  requestMemo       String?                   @map("request_memo")
  memo              String?
  source            ReservationSource
  canceledBy        String?                   @map("canceled_by") @db.Uuid
  cancelReason      String?                   @map("cancel_reason")
  canceledAt        DateTime?                 @map("canceled_at") @db.Timestamptz(6)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  artwork           Artwork?
  notifications     Notification[]
  canceledByUser    User?                     @relation("ReservationCanceledBy", fields: [canceledBy], references: [id])
  program           Program                   @relation(fields: [programId], references: [id])
  programSnapshot   ProgramSnapshot           @relation(fields: [programSnapshotId], references: [id])
  programTimeSlot   ProgramTimeSlot           @relation(fields: [programTimeSlotId], references: [id])
  store             Store                     @relation(fields: [storeId], references: [id])
  user              User                      @relation("ReservationUser", fields: [userId], references: [id])
  review            Review?

  @@map("reservations")
}

model Artwork {
  id                   String         @id @default(uuid()) @db.Uuid
  reservationId        String         @unique @map("reservation_id") @db.Uuid
  title                String         @default("내 작품") @db.VarChar(200)
  memo                 String?
  customerMemo         String?        @map("customer_memo")
  status               ArtworkStatus  @default(RESERVED)
  estimatedCompletedAt DateTime?      @map("estimated_completed_at") @db.Date
  trackingNumber       String?        @map("tracking_number") @db.VarChar(100)
  carrier              String?        @db.VarChar(50)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  logs                 ArtworkLog[]
  reservation          Reservation    @relation(fields: [reservationId], references: [id])
  notifications        Notification[]
  qrToken              QrToken?

  @@index([reservationId])
  @@index([status])
  @@map("artworks")
}

model ArtworkLog {
  id         String         @id @default(uuid()) @db.Uuid
  artworkId  String         @map("artwork_id") @db.Uuid
  changedBy  String         @map("changed_by") @db.Uuid
  fromStatus ArtworkStatus? @map("from_status")
  toStatus   ArtworkStatus  @map("to_status")
  memo       String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  artwork    Artwork        @relation(fields: [artworkId], references: [id])
  user       User           @relation(fields: [changedBy], references: [id])
  photos     ArtworkPhoto[]

  @@index([artworkId])
  @@map("artwork_logs")
}

model ArtworkPhoto {
  id           String     @id @default(uuid()) @db.Uuid
  artworkLogId String     @map("artwork_log_id") @db.Uuid
  imageUrl     String     @map("image_url") @db.VarChar(1000)
  thumbnailUrl String?    @map("thumbnail_url") @db.VarChar(1000)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  artworkLog   ArtworkLog @relation(fields: [artworkLogId], references: [id])

  @@index([artworkLogId])
  @@map("artwork_photos")
}

model Notification {
  id            String               @id @default(uuid()) @db.Uuid
  userId        String               @map("user_id") @db.Uuid
  artworkId     String?              @map("artwork_id") @db.Uuid
  reservationId String?              @map("reservation_id") @db.Uuid
  type          NotificationType
  title         String               @db.VarChar(200)
  body          String
  isRead        Boolean              @default(false) @map("is_read")
  sentAt        DateTime?            @map("sent_at") @db.Timestamptz(6)
  errorReason   String?              @map("error_reason")
  status        NotificationStatus   @default(PENDING)
  readAt        DateTime?            @map("read_at") @db.Timestamptz(6)
  channel       NotificationChannel?
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  artwork       Artwork?             @relation(fields: [artworkId], references: [id])
  reservation   Reservation?         @relation(fields: [reservationId], references: [id])
  user          User                 @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Report {
  id          String           @id @default(uuid()) @db.Uuid
  reporterId  String           @map("reporter_id") @db.Uuid
  targetType  ReportTargetType @map("target_type")
  targetId    String           @map("target_id") @db.Uuid
  reason      String           @db.VarChar(50)
  description String?
  status      ReportStatus     @default(PENDING)
  adminMemo   String?          @map("admin_memo")
  resolvedAt  DateTime?        @map("resolved_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  reporter    User             @relation(fields: [reporterId], references: [id])

  @@map("reports")
}

model QrToken {
  id        String    @id @default(uuid()) @db.Uuid
  artworkId String    @unique @map("artwork_id") @db.Uuid
  token     String    @unique @db.VarChar(100)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  artwork   Artwork   @relation(fields: [artworkId], references: [id])

  @@map("qr_tokens")
}

model Review {
  id            String        @id @default(uuid()) @db.Uuid
  reservationId String        @unique @map("reservation_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  storeId       String        @map("store_id") @db.Uuid
  rating        Int           @db.SmallInt
  body          String?
  isVisible     Boolean       @default(true) @map("is_visible")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  photos        ReviewPhoto[]
  reservation   Reservation   @relation(fields: [reservationId], references: [id])
  store         Store         @relation(fields: [storeId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@index([storeId])
  @@index([userId])
  @@map("reviews")
}

model ReviewPhoto {
  id           String   @id @default(uuid()) @db.Uuid
  reviewId     String   @map("review_id") @db.Uuid
  imageUrl     String   @map("image_url") @db.VarChar(1000)
  thumbnailUrl String?  @map("thumbnail_url") @db.VarChar(1000)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  review       Review   @relation(fields: [reviewId], references: [id])

  @@index([reviewId])
  @@map("review_photos")
}

model PolicyVersion {
  id          String        @id @default(uuid()) @db.Uuid
  policyType  PolicyType    @map("policy_type")
  version     String        @db.VarChar(20)
  url         String        @db.VarChar(500)
  isLatest    Boolean       @default(false) @map("is_latest")
  effectiveAt DateTime      @map("effective_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  consents    UserConsent[]

  @@map("policy_versions")
}

model UserConsent {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  policyVersionId String        @map("policy_version_id") @db.Uuid
  isAgreed        Boolean       @map("is_agreed")
  agreedAt        DateTime      @default(now()) @map("agreed_at") @db.Timestamptz(6)
  policyVersion   PolicyVersion @relation(fields: [policyVersionId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@unique([userId, policyVersionId])
  @@index([userId])
  @@map("user_consents")
}

enum UserStatus {
  ACTIVE
  WITHDRAWN
}

enum OAuthProvider {
  google
  kakao
}

enum PartnerStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
  TERMINATED
}

enum OcrStatus {
  PENDING
  SUCCESS
  FAILED
}

enum StoreStatus {
  DRAFT
  PENDING
  PUBLISHED
  SUSPENDED
}

enum ProgramDeliveryOption {
  DELIVERY
  PICKUP
  CUSTOMER_SELECT
}

enum ProgramStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum ProgramTimeSlotStatus {
  OPEN
  CLOSED
  CANCELED
}

enum ReservationDeliveryMethod {
  DELIVERY
  PICKUP
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELED
  IN_PROGRESS
  SHIPPED
  DELIVERED
  PICKUP_READY
  PICKUP_DONE
}

enum ReservationSource {
  CUSTOMER
  PARTNER_MANUAL
}

enum ArtworkStatus {
  RESERVED
  VISITED
  DRYING
  BISQUE_FIRING
  GLAZING
  GLAZE_FIRING
  COMPLETED
  CANCELED
}

enum NotificationType {
  STATUS_CHANGED
  RESERVATION_CONFIRMED
  SHIPPING_STARTED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationChannel {
  KAKAO_ALIMTALK
  EMAIL
  IN_APP
}

enum ReportTargetType {
  STORE
  CLASS
  PARTNER
}

enum ReportStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
}

enum PolicyType {
  PRIVACY_POLICY
  TERMS_OF_SERVICE
  MARKETING
}
