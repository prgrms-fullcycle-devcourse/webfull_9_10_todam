generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String               @id @default(uuid()) @db.Uuid
  nickname             String               @db.VarChar(100)
  email                String               @unique @db.VarChar(255)
  password             String?              @db.VarChar(255)
  isPartner            Boolean              @default(false) @map("is_partner")
  emailVerified        Boolean              @default(false) @map("email_verified") // [S-5]
  status               UserStatus           @default(ACTIVE)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  withdrawnAt          DateTime?            @map("withdrawn_at") @db.Timestamptz(6)
  artworkLogs          ArtworkLog[]
  notificationSettings NotificationSetting?
  notificationTokens   NotificationToken[]
  notifications        Notification[]
  oauthAccounts        OAuthAccount[]
  partner              Partner?
  refreshTokens        RefreshToken[]
  reports              Report[]
  canceledReservations Reservation[]        @relation("ReservationCanceledBy")
  reservations         Reservation[]        @relation("ReservationUser")
  reviews              Review[]
  consents             UserConsent[]
  favoriteStores       FavoriteStore[] // [S-6]

  @@map("users")
}

model NotificationSetting {
  id                 String   @id @default(uuid()) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  inAppEnabled       Boolean  @default(true) @map("in_app_enabled")
  emailEnabled       Boolean  @default(true) @map("email_enabled")
  kakaoEnabled       Boolean  @default(false) @map("kakao_enabled")
  webPushEnabled     Boolean  @default(true) @map("web_push_enabled") // Phase 2: Web Push 채널 on/off (#315)
  reservationEnabled Boolean  @default(true) @map("reservation_enabled")
  artworkEnabled     Boolean  @default(true) @map("artwork_enabled")
  shippingEnabled    Boolean  @default(true) @map("shipping_enabled")
  marketingEnabled   Boolean  @default(false) @map("marketing_enabled")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user               User     @relation(fields: [userId], references: [id])

  @@map("notification_settings")
}

model NotificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  fcmToken  String    @map("fcm_token")
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id])

  @@unique([userId, fcmToken])
  @@index([userId])
  @@map("notification_tokens")
}

model Admin {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255)
  name      String    @db.VarChar(100)
  createdAt DateTime? @map("created_at") @db.Timestamptz(6)

  @@map("admins")
}

model OAuthAccount {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  provider   OAuthProvider
  providerId String        @map("provider_id") @db.VarChar(255)
  user       User          @relation(fields: [userId], references: [id])

  @@unique([provider, providerId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Partner {
  id                  String             @id @default(uuid()) @db.Uuid
  userId              String             @unique @map("user_id") @db.Uuid
  status              PartnerStatus      @default(PENDING)
  rejectedReason      String?            @map("rejected_reason")
  suspendedReason     String?            @map("suspended_reason")
  approvedAt          DateTime?          @map("approved_at") @db.Timestamptz(6)
  suspendedAt         DateTime?          @map("suspended_at") @db.Timestamptz(6) // [S-9]
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  terminatedAt        DateTime?          @map("terminated_at") @db.Timestamptz(6)
  lastAccessedStoreId String?            @map("last_accessed_store_id") @db.Uuid
  businessDocs        BusinessDocument[]
  user                User               @relation(fields: [userId], references: [id])
  stores              Store[]            @relation("PartnerOwnedStores")
  lastAccessedStore   Store?             @relation("PartnerLastAccessedStore", fields: [lastAccessedStoreId], references: [id])

  @@map("partners")
}

model BusinessDocument {
  id                    String             @id @default(uuid()) @db.Uuid
  partnerId             String             @map("partner_id") @db.Uuid
  storeId               String             @map("store_id") @db.Uuid
  email                 String?            @map("email") @db.VarChar(255)
  documentUrl           String?            @map("document_url") @db.VarChar(1000)
  ownerName             String             @map("owner_name") @db.VarChar(100) // [S-4] representativeName → ownerName
  businessName          String             @map("business_name") @db.VarChar(200)
  businessNumber        String             @map("business_number") @db.VarChar(20)
  businessAddress       String             @map("business_address") @db.VarChar(500)
  startDate             String?            @map("start_date") @db.VarChar(8) // "YYYYMMDD", OCR prefill + 사용자 수정
  verificationStatus    VerificationStatus @default(PENDING) @map("verification_status")
  ntsRaw                Json?              @map("nts_raw")
  // 국세청 진위확인/상태조회 원본 응답 보관(감사·디버깅). 제출 시점에 채움.
  verifiedAt            DateTime?          @map("verified_at") @db.Timestamptz(6)
  // 진위확인 VERIFIED 통과 시에만 기록. MISMATCH/ERROR는 null.
  verificationCheckedAt DateTime?          @map("verification_checked_at") @db.Timestamptz(6)
  // verify 엔드포인트 매 호출 시 갱신 (결과 무관).
  businessState         BusinessState?     @map("business_state")
  // 국세청 상태조회 결과. VERIFIED 시에만 기록. ERROR/MISMATCH는 null.
  createdAt             DateTime?          @map("created_at") @db.Timestamptz(6)
  partner               Partner            @relation(fields: [partnerId], references: [id])
  store                 Store              @relation(fields: [storeId], references: [id])

  @@map("business_documents")
}

model Store {
  id                         String                   @id @default(uuid()) @db.Uuid
  partnerId                  String                   @map("partner_id") @db.Uuid
  name                       String                   @db.VarChar(200)
  slug                       String                   @unique @db.VarChar(100)
  convenienceInfo            Json?                    @map("convenience_info")
  rejectedReason             String?                  @map("rejected_reason")
  suspendedReason            String?                  @map("suspended_reason")
  description                String?
  address                    String?                  @db.VarChar(500)
  latitude                   Float?                   @map("latitude")
  longitude                  Float?                   @map("longitude")
  regionSido                 String?                  @map("region_sido") @db.VarChar(50) // 카카오 coord2regioncode 시·도 (예: 서울)
  regionSigungu              String?                  @map("region_sigungu") @db.VarChar(50) // 시·군·구 (예: 성동구)
  regionDong                 String?                  @map("region_dong") @db.VarChar(50) // 읍·면·동 (예: 성수동)
  phone                      String?                  @db.VarChar(20)
  autoConfirm                Boolean                  @default(false) @map("auto_confirm")
  cancelDeadlineDays         Int?                     @map("cancel_deadline_days")
  reservationIntervalMinutes Int?                     @map("reservation_interval_minutes") // 타임슬롯 생성 기준 간격(분)
  maxCapacityPerSlot         Int?                     @map("max_capacity_per_slot") // 슬롯당 최대 예약 정원(공방 단위 — 클래스 공통, 같은 슬롯 합산 한도)
  status                     StoreStatus              @default(DRAFT)
  publishedAt                DateTime?                @map("published_at") @db.Timestamptz(6)
  createdAt                  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  businessDocs               BusinessDocument[]
  timeSlots                  StoreTimeSlot[]
  timeSlotBlocks             TimeSlotBlock[]
  programs                   Program[]
  reservations               Reservation[]
  reviews                    Review[]
  images                     StoreImage[]
  operatingHours             StoreOperatingHour[]
  partner                    Partner                  @relation("PartnerOwnedStores", fields: [partnerId], references: [id])
  lastAccessedByPartners     Partner[]                @relation("PartnerLastAccessedStore")
  favoriteStores             FavoriteStore[] // [S-6]
  reservationRestrictions    ReservationRestriction[]

  @@index([slug])
  @@index([partnerId])
  @@index([status])
  @@map("stores")
}

model StoreOperatingHour {
  id         String    @id @default(uuid()) @db.Uuid
  storeId    String    @map("store_id") @db.Uuid
  dayOfWeek  DayOfWeek @map("day_of_week") // [S-1] Int → DayOfWeek enum
  openTime   DateTime  @map("open_time") @db.Time(6)
  closeTime  DateTime  @map("close_time") @db.Time(6)
  breakStart DateTime? @map("break_start") @db.Time(6) // [S-2] breakTime 분리
  breakEnd   DateTime? @map("break_end") @db.Time(6) // [S-2] breakTime 분리
  store      Store     @relation(fields: [storeId], references: [id])

  @@map("store_operating_hours")
}

model StoreImage {
  id          String            @id @default(uuid()) @db.Uuid
  storeId     String            @map("store_id") @db.Uuid
  imageUrl    String            @map("image_url") @db.VarChar(1000)
  sortOrder   Int               @default(0) @map("sort_order")
  isThumbnail Boolean           @default(false) @map("is_thumbnail") // [S-3] isPrimary → isThumbnail
  status      ImageUploadStatus @default(PENDING) @map("status")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  store       Store             @relation(fields: [storeId], references: [id])

  @@map("store_images")
}

model FavoriteStore {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id])
  store     Store    @relation(fields: [storeId], references: [id])

  @@unique([userId, storeId])
  @@index([userId])
  @@map("favorite_stores")
}

model Program {
  id                      String                   @id @default(uuid()) @db.Uuid
  storeId                 String                   @map("store_id") @db.Uuid
  title                   String                   @db.VarChar(200)
  description             String?
  materials               String?
  caution                 String?
  price                   Int
  durationMinutes         Int                      @map("duration_minutes")
  difficulty              ProgramDifficulty        @default(BASIC)
  childFriendly           Boolean                  @default(false) @map("child_friendly")
  leadTimeDays            Int                      @default(30) @map("lead_time_days")
  deliverable             Boolean                  @default(false)
  status                  ProgramStatus            @default(DRAFT)
  sortOrder               Int                      @default(0) @map("sort_order") // [S-10]
  createdAt               DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  snapshots               ProgramSnapshot[]
  store                   Store                    @relation(fields: [storeId], references: [id])
  reservations            Reservation[]
  images                  ProgramImage[] // [S-7]
  reservationRestrictions ReservationRestriction[]

  @@map("programs")
}

model ProgramImage {
  id          String            @id @default(uuid()) @db.Uuid
  programId   String            @map("program_id") @db.Uuid
  imageUrl    String            @map("image_url") @db.VarChar(1000)
  sortOrder   Int               @default(0) @map("sort_order")
  isThumbnail Boolean           @default(false) @map("is_thumbnail")
  status      ImageUploadStatus @default(PENDING) @map("status")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  program     Program           @relation(fields: [programId], references: [id])

  @@index([programId])
  @@map("program_images")
}

model ProgramSnapshot {
  id           String        @id @default(uuid()) @db.Uuid
  programId    String        @map("program_id") @db.Uuid
  price        Int
  leadTimeDays Int           @map("lead_time_days")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  program      Program       @relation(fields: [programId], references: [id])
  reservations Reservation[]

  @@map("program_snapshots")
}

model StoreTimeSlot {
  id            String              @id @default(uuid()) @db.Uuid
  storeId       String              @map("store_id") @db.Uuid
  startAt       DateTime            @map("start_at") @db.Timestamptz(6)
  endAt         DateTime            @map("end_at") @db.Timestamptz(6)
  reservedCount Int                 @default(0) @map("reserved_count")
  status        StoreTimeSlotStatus @default(OPEN)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  store         Store               @relation(fields: [storeId], references: [id])
  reservations  Reservation[]

  // 예약 materialize와 동일 슬롯 정원 CAS 용도. 차단 상태는 TimeSlotBlock이 담당한다.
  // 같은 시작시각에 길이가 다른 과거/현재 예약 슬롯이 공존할 수 있다.
  @@unique([storeId, startAt, endAt])
  @@index([status])
  @@map("store_time_slots")
}

model TimeSlotBlock {
  id        String              @id @default(uuid()) @db.Uuid
  storeId   String              @map("store_id") @db.Uuid
  startAt   DateTime            @map("start_at") @db.Timestamptz(6)
  endAt     DateTime            @map("end_at") @db.Timestamptz(6)
  status    StoreTimeSlotStatus
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  store     Store               @relation(fields: [storeId], references: [id])

  @@unique([storeId, startAt, endAt, status])
  @@index([storeId, startAt, endAt])
  @@map("time_slot_blocks")
}

model ReservationRestriction {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  startAt   DateTime @map("start_at") @db.Timestamptz(6)
  endAt     DateTime @map("end_at") @db.Timestamptz(6)
  programId String   @map("program_id") @db.Uuid
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  store     Store    @relation(fields: [storeId], references: [id])
  program   Program  @relation(fields: [programId], references: [id])

  @@unique([storeId, startAt, programId])
  @@index([storeId])
  @@map("reservation_restrictions")
}

model Reservation {
  id                String                    @id @default(uuid()) @db.Uuid
  userId            String?                   @map("user_id") @db.Uuid // null은 source=PARTNER_MANUAL(비회원 현장 예약)일 때만 허용
  programId         String                    @map("program_id") @db.Uuid
  storeId           String                    @map("store_id") @db.Uuid
  storeTimeSlotId   String                    @map("store_time_slot_id") @db.Uuid
  programSnapshotId String                    @map("program_snapshot_id") @db.Uuid
  scheduledAt       DateTime                  @map("scheduled_at") @db.Timestamptz(6)
  scheduledEndAt    DateTime                  @map("scheduled_end_at") @db.Timestamptz(6)
  reserverName      String                    @map("reserver_name") @db.VarChar(100)
  reserverPhone     String                    @map("reserver_phone") @db.VarChar(20)
  participantCount  Int                       @default(1) @map("participant_count")
  deliveryMethod    ReservationDeliveryMethod @map("delivery_method")
  status            ReservationStatus         @default(PENDING)
  requestMemo       String?                   @map("request_memo")
  internalMemo      String?                   @map("internal_memo")
  source            ReservationSource
  canceledBy        String?                   @map("canceled_by") @db.Uuid
  cancelReason      String?                   @map("cancel_reason")
  canceledAt        DateTime?                 @map("canceled_at") @db.Timestamptz(6)
  pickupReadyAt     DateTime?                 @map("pickup_ready_at") @db.Timestamptz(6)
  pickupDoneAt      DateTime?                 @map("pickup_done_at") @db.Timestamptz(6)
  deliveredAt       DateTime?                 @map("delivered_at") @db.Timestamptz(6)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  artwork           Artwork?
  delivery          Delivery?
  notifications     Notification[]
  canceledByUser    User?                     @relation("ReservationCanceledBy", fields: [canceledBy], references: [id])
  program           Program                   @relation(fields: [programId], references: [id])
  programSnapshot   ProgramSnapshot           @relation(fields: [programSnapshotId], references: [id])
  storeTimeSlot     StoreTimeSlot             @relation(fields: [storeTimeSlotId], references: [id])
  store             Store                     @relation(fields: [storeId], references: [id])
  user              User?                     @relation("ReservationUser", fields: [userId], references: [id])
  review            Review?

  @@map("reservations")
}

model Artwork {
  id                   String         @id @default(uuid()) @db.Uuid
  reservationId        String         @unique @map("reservation_id") @db.Uuid
  title                String         @default("내 작품") @db.VarChar(200)
  internalMemo         String?        @map("internal_memo")
  customerMemo         String?        @map("customer_memo")
  status               ArtworkStatus  @default(RESERVED)
  estimatedCompletedAt DateTime?      @map("estimated_completed_at") @db.Date
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  logs                 ArtworkLog[]
  reservation          Reservation    @relation(fields: [reservationId], references: [id])
  notifications        Notification[]
  qrToken              QrToken?

  @@index([reservationId])
  @@index([status])
  @@map("artworks")
}

model Delivery {
  id              String      @id @default(uuid()) @db.Uuid
  reservationId   String      @unique @map("reservation_id") @db.Uuid
  recipientName   String?     @map("recipient_name") @db.VarChar(100) // 수령인(예약자와 다를 수 있음)
  recipientPhone  String?     @map("recipient_phone") @db.VarChar(20)
  postalCode      String?     @map("postal_code") @db.VarChar(10) // 우편번호(주소검색 API)
  shippingAddress String?     @map("shipping_address") // 기본주소(도로명/지번)
  addressDetail   String?     @map("address_detail") @db.VarChar(200) // 상세주소(동·호수 등)
  trackingNumber  String?     @map("tracking_number") @db.VarChar(100)
  carrier         String?     @db.VarChar(50)
  shippedAt       DateTime?   @map("shipped_at") @db.Date
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  reservation     Reservation @relation(fields: [reservationId], references: [id])

  @@map("deliveries")
}

model ArtworkLog {
  id         String         @id @default(uuid()) @db.Uuid
  artworkId  String         @map("artwork_id") @db.Uuid
  changedBy  String         @map("changed_by") @db.Uuid
  fromStatus ArtworkStatus? @map("from_status")
  toStatus   ArtworkStatus  @map("to_status")
  memo       String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  artwork    Artwork        @relation(fields: [artworkId], references: [id])
  user       User           @relation(fields: [changedBy], references: [id])
  photos     ArtworkPhoto[]

  @@index([artworkId])
  @@map("artwork_logs")
}

model ArtworkPhoto {
  id           String            @id @default(uuid()) @db.Uuid
  artworkLogId String            @map("artwork_log_id") @db.Uuid
  imageUrl     String            @map("image_url") @db.VarChar(1000)
  status       ImageUploadStatus @default(PENDING) @map("status")
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  artworkLog   ArtworkLog        @relation(fields: [artworkLogId], references: [id])

  @@index([artworkLogId])
  @@map("artwork_photos")
}

// Phase 3a: Notification 모델 reconcile (Option A) — contract 형태로 재편
// userId 컬럼 유지 (도메인/DTO에서 recipientId로 매핑)
// artworkId/reservationId 내부용 유지 (deepLink 생성에 활용)
// 발송상태(sentAt/status/channel/errorReason) → NotificationDelivery로 이동
model Notification {
  id             String                 @id @default(uuid()) @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  artworkId      String?                @map("artwork_id") @db.Uuid
  reservationId  String?                @map("reservation_id") @db.Uuid
  eventType      String                 @map("event_type")
  category       NotificationCategory
  title          String                 @db.VarChar(200)
  body           String
  deepLink       String?                @map("deep_link")
  idempotencyKey String                 @unique @map("idempotency_key")
  readAt         DateTime?              @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  artwork        Artwork?               @relation(fields: [artworkId], references: [id])
  reservation    Reservation?           @relation(fields: [reservationId], references: [id])
  user           User                   @relation(fields: [userId], references: [id])
  deliveries     NotificationDelivery[]

  @@index([userId])
  @@map("notifications")
}

// Phase 3a: 채널별 발송 시도 기록 (FCM 발송은 Phase 3b)
model NotificationDelivery {
  id             String                      @id @default(uuid()) @db.Uuid
  notificationId String                      @map("notification_id") @db.Uuid
  channel        NotificationDeliveryChannel
  status         NotificationDeliveryStatus  @default(PENDING)
  attempts       Int                         @default(0)
  failedReason   String?                     @map("failed_reason")
  sentAt         DateTime?                   @map("sent_at") @db.Timestamptz(6)
  notification   Notification                @relation(fields: [notificationId], references: [id])

  @@index([notificationId])
  @@map("notification_deliveries")
}

model Report {
  id          String           @id @default(uuid()) @db.Uuid
  reporterId  String           @map("reporter_id") @db.Uuid
  targetType  ReportTargetType @map("target_type")
  targetId    String           @map("target_id") @db.Uuid
  reason      String           @db.VarChar(50)
  description String?
  status      ReportStatus     @default(PENDING)
  adminMemo   String?          @map("admin_memo")
  resolvedAt  DateTime?        @map("resolved_at") @db.Timestamptz(6)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  reporter    User             @relation(fields: [reporterId], references: [id])

  @@map("reports")
}

model QrToken {
  id        String    @id @default(uuid()) @db.Uuid
  artworkId String    @unique @map("artwork_id") @db.Uuid
  token     String    @unique @db.VarChar(100)
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  artwork   Artwork   @relation(fields: [artworkId], references: [id])

  @@map("qr_tokens")
}

model Review {
  id            String        @id @default(uuid()) @db.Uuid
  reservationId String        @unique @map("reservation_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  storeId       String        @map("store_id") @db.Uuid
  rating        Int           @db.SmallInt
  content       String?
  isVisible     Boolean       @default(true) @map("is_visible")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  photos        ReviewPhoto[]
  reservation   Reservation   @relation(fields: [reservationId], references: [id])
  store         Store         @relation(fields: [storeId], references: [id])
  user          User          @relation(fields: [userId], references: [id])

  @@index([storeId])
  @@index([userId])
  @@map("reviews")
}

model ReviewPhoto {
  id        String   @id @default(uuid()) @db.Uuid
  reviewId  String   @map("review_id") @db.Uuid
  imageUrl  String   @map("image_url") @db.VarChar(1000)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  review    Review   @relation(fields: [reviewId], references: [id])

  @@index([reviewId])
  @@map("review_photos")
}

model PolicyVersion {
  id          String        @id @default(uuid()) @db.Uuid
  policyType  PolicyType    @map("policy_type")
  version     String        @db.VarChar(20)
  url         String        @db.VarChar(500)
  isLatest    Boolean       @default(false) @map("is_latest")
  effectiveAt DateTime      @map("effective_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  consents    UserConsent[]

  @@map("policy_versions")
}

model UserConsent {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  policyVersionId String        @map("policy_version_id") @db.Uuid
  isAgreed        Boolean       @map("is_agreed")
  agreedAt        DateTime      @default(now()) @map("agreed_at") @db.Timestamptz(6)
  policyVersion   PolicyVersion @relation(fields: [policyVersionId], references: [id])
  user            User          @relation(fields: [userId], references: [id])

  @@unique([userId, policyVersionId])
  @@index([userId])
  @@map("user_consents")
}

