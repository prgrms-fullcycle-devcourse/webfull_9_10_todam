# apps/web/.env
NODE_ENV=
NEXT_PUBLIC_API_URL=
# enabled | disabled — MSW mock 전역 스위치
NEXT_PUBLIC_API_MOCKING=
# Kakao Maps JS 키 (주소→좌표 geocode)
NEXT_PUBLIC_KAKAO_MAP_KEY=
# OAuth 소셜 로그인 클라이언트 키
# 카카오 REST API 키 (카카오 개발자 콘솔 > 앱 > 앱 키 > REST API 키)
NEXT_PUBLIC_KAKAO_CLIENT_ID=
# 구글 OAuth 2.0 클라이언트 ID (구글 클라우드 콘솔 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# 배포 도메인 (redirect_uri 기준, 미설정 시 window.location.origin 사용)
NEXT_PUBLIC_APP_URL=
