{
  "name": "todam",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo build --concurrency=1",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "prepare": "husky",
    "api": "turbo dev --filter=@todam/api",
    "web": "turbo dev --filter=@todam/web",
    "admin": "turbo dev --filter=@todam/admin",
    "storybook": "turbo dev --filter=@todam/storybook",
    "mobile": "node scripts/mobile-dev.mjs",
    "all": "concurrently -n api,web,mobile -c green,cyan,magenta \"pnpm api\" \"pnpm web\" \"pnpm mobile\""
  },
  "lint-staged": {
    "apps/api/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "apps/admin/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/**/*.ts": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@typescript-eslint/eslint-plugin": ">=8.0.0 <8.59.0",
      "@typescript-eslint/parser": ">=8.0.0 <8.59.0",
      "@typescript-eslint/scope-manager": ">=8.0.0 <8.59.0",
      "typescript": "5.9.3"
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "qrcode-terminal": "^0.12.0",
    "turbo": "^2.9.14",
    "typescript": "^5.9.3"
  }
}
